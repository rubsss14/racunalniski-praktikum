Cell[BoxData[{
 RowBox[{"z", "/.", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"Conjugate", "[", "z", "]"}], "==", " ", 
    RowBox[{"z", "^", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "a", " ", "x"}], "+", 
       RowBox[{"3", " ", "a"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "a"}], "+", 
       RowBox[{"5", " ", "x"}]}], ")"}]}], " ", "==", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "a"}], "-", "4"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "a"}], "-", 
       RowBox[{"5", " ", "x"}]}], ")"}]}]}], "/.", 
   RowBox[{"x", "->", "2"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9751357913765335`*^9, 3.9751359714181423`*^9}, {
  3.975136014512762*^9, 3.975136037736088*^9}, {3.975136068441601*^9, 
