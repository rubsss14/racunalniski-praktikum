   3.943442524863378*^9}},ExpressionUUID->"f70b6e9b-cb45-45f0-89ec-\
3fca4faa33ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "-", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "-", "4"}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
     RowBox[{"ExclusionsStyle", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Dashed", ",", "Red"}], "}"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"x", "/.", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "==", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"x", "/.", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Denominator", "[", 
       RowBox[{"f", "[", "x", "]"}], "]"}], "==", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"x", "->", 
      RowBox[{"-", "2"}]}], ",", " ", 
     RowBox[{"Direction", "->", 
      RowBox[{"-", "1"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", " ", 
     RowBox[{"x", "->", " ", "Infinity"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"x", "/.", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "'"}], "[", "x", "]"}], "==", "0"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "''"}], "[", "x", "]"}], ">", "0"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9751319797885323`*^9, 3.9751320769160976`*^9}, {
   3.9751322591261234`*^9, 3.9751323992150726`*^9}, 3.9751324370545864`*^9, {
