 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Solve", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "==", 
      RowBox[{"h", "+", "3"}]}], ",", " ", 
     RowBox[{"m", "==", 
      RowBox[{"23", "+", "s"}]}], ",", " ", 
     RowBox[{
      RowBox[{"m", "-", "6"}], "==", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "6", "+", "h", "-", "6"}], ")"}]}]}]}], "}"}], 
   "]"}]}]], "Input",
