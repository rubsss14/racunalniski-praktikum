Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "-", "t"}], ")"}], " ", 
     RowBox[{
      RowBox[{"Sin", "[", "t", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"t", "+", "1"}], ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", "t"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"k", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "5"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"resitev1", " ", "=", " ", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"k", "[", "t", "]"}], "==", 
     RowBox[{"k", "[", "s", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"resitev2", " ", "=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"k", "[", "t", "]"}], "==", 
     RowBox[{"k", "[", "s", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "3"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"tocka1", " ", "=", " ", 
  RowBox[{
   RowBox[{"k", "[", "t", "]"}], "/.", "resitev1"}]}], "\[IndentingNewLine]", 
 RowBox[{"tocka2", " ", "=", " ", 
  RowBox[{
   RowBox[{"k", "[", "t", "]"}], "/.", "resitev2"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"k", "[", "t", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "5"}], "}"}], ",", " ", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "Large", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", 
        RowBox[{"tocka1", ",", "tocka2"}], "}"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.975133190812683*^9, 3.975133365703993*^9}, {
